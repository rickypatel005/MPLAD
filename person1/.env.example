# SIH26102 — Person 1 (Data & Backend Service) Configuration Template

# Server Port & Runtime
PORT=3000
NODE_ENV="development"

# PostgreSQL / PostGIS 15 Database Configuration
DATABASE_URL="postgresql://mplads_admin:sih26102_secure_pwd@localhost:5432/mplads_audit"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="mplads_audit"
POSTGRES_USER="mplads_admin"
POSTGRES_PASSWORD="sih26102_secure_pwd"

# JWT Authentication & RBAC
# Secret key for signing HMAC-SHA256 JWT tokens. Must be >= 32 bytes in production.
JWT_SECRET="replace-with-a-unique-32-byte-secret-in-production"

# Downstream Microservices Integration
PERSON2_SERVICE_URL="http://127.0.0.1:8002"
PERSON3_SERVICE_URL="http://127.0.0.1:8000"

# Explicit Offline/Mock Mode (set to 'true' for purely offline test harness)
MOCK_MODE="false"

# Google Gemini API Key (for Forensic AI Auditor analysis)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public App Base URL (optional)
APP_URL="http://localhost:3000"
