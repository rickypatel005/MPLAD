# Copy to .env.local before running the app.
#
# Mock mode: "/api" (Next.js route handlers implementing the TRD §5 contract).
# Live mode: the FastAPI base URL, e.g. http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=/api

# MP anonymisation default. Keep "true" for public/judged demo runs.
NEXT_PUBLIC_DEFAULT_ANONYMIZE=true
